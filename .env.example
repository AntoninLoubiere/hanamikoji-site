DJANGO_ENV=developpement # ou production
DJANGO_SETTINGS_MODULE=website.settings
PYTHONUNBUFFERED=1

# Django security/runtime
DJANGO_SECRET_KEY=change-this-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Obligatoire derriere un reverse proxy: adapter les ports/domaines utilises
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1,http://localhost

# Django superuser bootstrap (used by createsuperuser --noinput)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-this-password

# Database
# En production: DJANGO_ENV=production et PostgreSQL est utilise automatiquement
# En developpement: SQLite est utilise automatiquement
DB_NAME=hanamikoji
DB_USER=hanamikoji
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432

# Game runtime
MATCH_RULES=/usr/lib64/libhanamikoji.so
